[Unit]
Description=NABI Office AI web
After=network.target

[Service]
Type=simple
User=nabi-office
Group=nabi-office
WorkingDirectory=/opt/nabi-office/current
EnvironmentFile=/etc/nabi-office/environment
ExecStart=/opt/nabi-office/venv/bin/python /opt/nabi-office/current/serve.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nabi-office/data

[Install]
WantedBy=multi-user.target
